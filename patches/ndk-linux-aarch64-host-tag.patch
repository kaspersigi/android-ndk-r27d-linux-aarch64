 import sys
@@ -82,6 +83,9 @@ def get_host_tag_or_die():
     """Return the host tag for this platform. Die if not supported."""
     if sys.platform.startswith("linux"):
-        return "linux-x86_64"
+        machine = platform.machine().lower()
+        if machine in ("aarch64", "arm64"):
