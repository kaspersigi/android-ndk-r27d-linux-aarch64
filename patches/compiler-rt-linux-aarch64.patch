diff --git a/compiler-rt/lib/sanitizer_common/sanitizer_platform_limits_posix.cpp b/compiler-rt/lib/sanitizer_common/sanitizer_platform_limits_posix.cpp
index 6d61d276d..277463d05 100644
--- a/compiler-rt/lib/sanitizer_common/sanitizer_platform_limits_posix.cpp
+++ b/compiler-rt/lib/sanitizer_common/sanitizer_platform_limits_posix.cpp
@@ -480,7 +480,14 @@ unsigned struct_ElfW_Phdr_sz = sizeof(Elf_Phdr);
   unsigned struct_mtpos_sz = sizeof(struct mtpos);
   unsigned struct_rtentry_sz = sizeof(struct rtentry);
 #if SANITIZER_GLIBC || SANITIZER_ANDROID
+#if defined(__aarch64__) && SANITIZER_GLIBC
+  // glibc 2.42 no longer installs the legacy termio.h declaration. The
+  // Linux UAPI termio layout on AArch64 is four 16-bit flags, one line byte,
+  // and NCC (8) control bytes, rounded to 18 bytes.
+  unsigned struct_termio_sz = 18;
+#else
   unsigned struct_termio_sz = sizeof(struct termio);
+#endif
 #endif
   unsigned struct_vt_consize_sz = sizeof(struct vt_consize);
   unsigned struct_vt_sizes_sz = sizeof(struct vt_sizes);
diff --git a/compiler-rt/lib/tsan/dd/CMakeLists.txt b/compiler-rt/lib/tsan/dd/CMakeLists.txt
index a7359c573..3d73a41b7 100644
--- a/compiler-rt/lib/tsan/dd/CMakeLists.txt
+++ b/compiler-rt/lib/tsan/dd/CMakeLists.txt
@@ -22,9 +22,13 @@ append_list_if(COMPILER_RT_HAS_LIBPTHREAD pthread DD_LINKLIBS)
 add_custom_target(dd)
 set_target_properties(dd PROPERTIES FOLDER "Compiler-RT Misc")
 
-# Deadlock detector is currently supported on 64-bit Linux only.
-if(CAN_TARGET_x86_64 AND UNIX AND NOT APPLE AND NOT ANDROID)
-  set(arch "x86_64")
+# Deadlock detector is built for the selected 64-bit Linux host.
+if((CAN_TARGET_x86_64 OR CAN_TARGET_aarch64) AND UNIX AND NOT APPLE AND NOT ANDROID)
+  if(CAN_TARGET_aarch64)
+    set(arch "aarch64")
+  else()
+    set(arch "x86_64")
+  endif()
   add_compiler_rt_runtime(clang_rt.dd
     STATIC
     ARCHS ${arch}
